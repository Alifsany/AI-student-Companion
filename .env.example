# Environment variables template
# Copy this file to .env and fill in the values.
# ALL variables listed here must also be added to Vercel → Project Settings → Environment Variables.

# ---------------------------------------------------------------------------
# Database (REQUIRED)
# ---------------------------------------------------------------------------
# Neon PostgreSQL connection string (pooled).
# Get from: https://console.neon.tech → Your Project → Connection Details → Pooled connection
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Authentication (REQUIRED)
# ---------------------------------------------------------------------------
# Secret key used to sign session JWTs. Must be at least 32 chars.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The canonical URL of the application (used for OAuth callbacks).
# Local development: http://localhost:3000
# Production on Vercel: https://your-app.vercel.app  (use your actual Vercel URL)
AUTH_URL=""

# ---------------------------------------------------------------------------
# Google OAuth (REQUIRED for Google Sign-In)
# ---------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/ → APIs & Services → Credentials
# After deployment, add the following Authorized redirect URI:
#   https://your-app.vercel.app/api/auth/callback/google
# For local development also add:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# AI / Gemini (REQUIRED for all AI features)
# ---------------------------------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ---------------------------------------------------------------------------
# Document Storage (REQUIRED for Vercel deployment)
# ---------------------------------------------------------------------------
# Vercel Blob token for storing uploaded PDFs.
# Get from: https://vercel.com/docs/storage/vercel-blob
# When developing locally, you can omit this to use the local filesystem.
# In production on Vercel, this is REQUIRED.
BLOB_READ_WRITE_TOKEN=""
