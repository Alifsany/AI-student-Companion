# Environment variables template
# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string.
# Example: postgresql://username:password@host:5432/database?schema=public
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret key used to sign session JWTs.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# The canonical URL of the application (used for OAuth callbacks).
# Example: http://localhost:3000 for development
AUTH_URL=""

# ---------------------------------------------------------------------------
# Google OAuth (Work Item 2.1 — activate when credentials are available)
# ---------------------------------------------------------------------------
# Obtain from: https://console.cloud.google.com/
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
