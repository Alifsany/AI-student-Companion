// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  PRESENTATION
  STUDY
  OTHER
}

enum GoalType {
  TARGET_GPA
  ACADEMIC_PERFORMANCE
  STUDY_CONSISTENCY
  SKILL_DEVELOPMENT
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                  String    @id @default(uuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  passwordHash        String?
  image               String?
  role                UserRole  @default(STUDENT)
  onboardingCompleted Boolean   @default(false)

  // Student Profile & Academic Info
  bio         String? @db.Text
  institution String?
  gradeLevel  String?
  major       String?
  targetGpa   Float?

  // Preferences & Personalization
  preferences Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Auth Relations
  accounts Account[]
  sessions Session[]

  // Core Data
  subjects        Subject[]
  tasks           AcademicTask[]
  goals           AcademicGoal[]
  conversations   Conversation[]
  academicRecords AcademicRecord[]
  studySessions   StudySession[]
  studyPlanItems  StudyPlanItem[]
  quizAttempts    QuizAttempt[]
  documents       Document[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

model Subject {
  id     String @id @default(uuid())
  userId String
  name   String

  // New Fields for Work Item 5.1
  code         String?
  department   String?
  semester     String?
  academicYear String?
  creditHours  Float?
  status       SubjectStatus @default(ACTIVE)

  // Existing Optional Fields
  teacherName String?
  description String? @db.Text
  color       String?
  targetGoal  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks           AcademicTask[]
  academicRecords AcademicRecord[]
  studySessions   StudySession[]
  studyPlanItems  StudyPlanItem[]
  documents       Document[]

  @@index([userId])
  @@index([status])
}

model AcademicTask {
  id          String       @id @default(uuid())
  title       String
  description String?      @db.Text
  type        TaskType     @default(ASSIGNMENT)
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)

  userId    String
  subjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject        Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  studySessions  StudySession[]
  studyPlanItems StudyPlanItem[]

  @@index([userId])
  @@index([subjectId])
  @@index([dueDate])
  @@index([status])
}

model AcademicGoal {
  id          String     @id @default(uuid())
  userId      String
  title       String
  description String?    @db.Text
  type        GoalType   @default(OTHER)
  targetValue String?
  deadline    DateTime?
  status      GoalStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlanItems StudyPlanItem[]

  @@index([userId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String   @db.Text
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AcademicRecord {
  id           String @id @default(uuid())
  userId       String
  subjectId    String
  semester     String
  academicYear String
  creditHours  Float
  grade        String
  gradePoint   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // Prevent accidental duplicates in the same semester while allowing retakes in different semesters
  @@unique([userId, subjectId, semester, academicYear])
  @@index([userId])
  @@index([subjectId])
  @@index([semester, academicYear])
}

enum StudySessionType {
  POMODORO
  CUSTOM
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model StudySession {
  id        String             @id @default(uuid())
  userId    String
  subjectId String?
  taskId    String?
  type      StudySessionType   @default(POMODORO)
  status    StudySessionStatus @default(ACTIVE)

  // Timestamps for duration calculation
  startedAt DateTime  @default(now())
  resumedAt DateTime  @default(now()) // Updated on each resume
  endedAt   DateTime?

  // Durations (in seconds)
  duration        Int     @default(0) // Accumulated duration
  plannedDuration Int     @default(1500) // Default 25 mins
  notes           String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task    AcademicTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  studyPlanItemId String?
  studyPlanItem   StudyPlanItem? @relation(fields: [studyPlanItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([subjectId])
  @@index([taskId])
}

enum StudyPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model StudyPlanItem {
  id              String          @id @default(uuid())
  userId          String
  title           String
  description     String?         @db.Text
  plannedDate     DateTime
  plannedDuration Int             @default(3600)
  status          StudyPlanStatus @default(PLANNED)

  subjectId String?
  taskId    String?
  goalId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task    AcademicTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goal    AcademicGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  studySessions StudySession[]

  @@index([userId])
  @@index([plannedDate])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Quiz & Mock Exam — Work Item 6.3
// ---------------------------------------------------------------------------

enum QuizMode {
  QUIZ
  MOCK_EXAM
}

model QuizAttempt {
  id          String   @id @default(uuid())
  userId      String
  subjectId   String?
  subjectName String? // denormalized for history display
  title       String
  mode        QuizMode @default(QUIZ)

  totalQuestions Int   @default(0)
  correctCount   Int   @default(0)
  incorrectCount Int   @default(0)
  skippedCount   Int   @default(0)
  score          Float @default(0) // percentage 0-100

  timeLimitSeconds Int? // null = untimed
  timeUsedSeconds  Int  @default(0)

  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionResults QuizQuestionResult[]

  @@index([userId])
  @@index([completedAt])
  @@index([subjectId])
}

model QuizQuestionResult {
  id                 String @id @default(uuid())
  quizAttemptId      String
  questionId         String
  questionText       String @db.Text
  questionType       String
  questionDifficulty String

  studentAnswer String  @db.Text
  correctAnswer String  @db.Text
  isCorrect     Boolean
  feedback      String  @db.Text
  explanation   String  @db.Text

  markedForReview Boolean @default(false)

  createdAt DateTime @default(now())

  quizAttempt QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)

  @@index([quizAttemptId])
}

// ---------------------------------------------------------------------------
// Notes & PDF Intelligence — Work Item 7.1
// ---------------------------------------------------------------------------

enum DocumentUploadStatus {
  UPLOADING
  READY
  PROCESSING
  FAILED
}

model Document {
  id              String               @id @default(uuid())
  userId          String
  filename        String
  fileUrl         String               @db.Text // Local path or remote URL
  fileType        String
  size            Int
  status          DocumentUploadStatus @default(PROCESSING)

  // Text Extraction fields
  extractedText   String?              @db.Text
  extractedAt     DateTime?
  extractionError String?              @db.Text

  // AI Summarization fields
  summaryText        String?           @db.Text
  summaryGeneratedAt DateTime?
  summaryError       String?           @db.Text

  // AI Structured fields
  formulas           Json?
  keyTopics          Json?
  importantPoints    Json?

  subjectId       String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
}

