generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String           @id @default(uuid())
  name                String?
  email               String           @unique
  emailVerified       DateTime?
  passwordHash        String?
  image               String?
  role                UserRole         @default(STUDENT)
  onboardingCompleted Boolean          @default(false)
  bio                 String?
  institution         String?
  gradeLevel          String?
  major               String?
  targetGpa           Float?
  preferences         Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  goals               AcademicGoal[]
  academicRecords     AcademicRecord[]
  tasks               AcademicTask[]
  accounts            Account[]
  conversations       Conversation[]
  documents           Document[]
  quizAttempts        QuizAttempt[]
  sessions            Session[]
  studyPlanItems      StudyPlanItem[]
  studySessions       StudySession[]
  subjects            Subject[]
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subject {
  id              String           @id @default(uuid())
  userId          String
  name            String
  teacherName     String?
  description     String?
  color           String?
  targetGoal      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  academicYear    String?
  code            String?
  creditHours     Float?
  department      String?
  semester        String?
  status          SubjectStatus    @default(ACTIVE)
  academicRecords AcademicRecord[]
  tasks           AcademicTask[]
  documents       Document[]
  studyPlanItems  StudyPlanItem[]
  studySessions   StudySession[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AcademicTask {
  id             String          @id @default(uuid())
  title          String
  description    String?
  dueDate        DateTime?
  priority       TaskPriority    @default(MEDIUM)
  status         TaskStatus      @default(TODO)
  userId         String
  subjectId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  type           TaskType        @default(ASSIGNMENT)
  taskId         String?
  subject        Subject?        @relation(fields: [subjectId], references: [id])
  task           AcademicTask?   @relation("TaskSubtasks", fields: [taskId], references: [id])
  subtasks       AcademicTask[]  @relation("TaskSubtasks")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlanItems StudyPlanItem[]
  studySessions  StudySession[]

  @@index([userId])
  @@index([subjectId])
  @@index([taskId])
  @@index([dueDate])
  @@index([status])
}

model AcademicGoal {
  id             String          @id @default(uuid())
  userId         String
  title          String
  description    String?
  type           GoalType        @default(OTHER)
  targetValue    String?
  deadline       DateTime?
  status         GoalStatus      @default(NOT_STARTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studyPlanItems StudyPlanItem[]

  @@index([userId])
  @@index([status])
}

model Conversation {
  id        String    @id @default(uuid())
  title     String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AcademicRecord {
  id           String   @id @default(uuid())
  userId       String
  subjectId    String
  semester     String
  academicYear String
  creditHours  Float
  grade        String
  gradePoint   Float
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, semester, academicYear])
  @@index([userId])
  @@index([subjectId])
  @@index([semester, academicYear])
}

model StudySession {
  id              String             @id @default(uuid())
  userId          String
  subjectId       String?
  taskId          String?
  type            StudySessionType   @default(POMODORO)
  status          StudySessionStatus @default(ACTIVE)
  startedAt       DateTime           @default(now())
  resumedAt       DateTime           @default(now())
  endedAt         DateTime?
  duration        Int                @default(0)
  plannedDuration Int                @default(1500)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  studyPlanItemId String?
  studyPlanItem   StudyPlanItem?     @relation(fields: [studyPlanItemId], references: [id])
  subject         Subject?           @relation(fields: [subjectId], references: [id])
  task            AcademicTask?      @relation(fields: [taskId], references: [id])
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([subjectId])
  @@index([taskId])
}

model StudyPlanItem {
  id              String          @id @default(uuid())
  userId          String
  title           String
  description     String?
  plannedDate     DateTime
  plannedDuration Int             @default(3600)
  status          StudyPlanStatus @default(PLANNED)
  subjectId       String?
  taskId          String?
  goalId          String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  goal            AcademicGoal?   @relation(fields: [goalId], references: [id])
  subject         Subject?        @relation(fields: [subjectId], references: [id])
  task            AcademicTask?   @relation(fields: [taskId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions   StudySession[]

  @@index([userId])
  @@index([plannedDate])
  @@index([status])
}

model QuizAttempt {
  id               String               @id @default(uuid())
  userId           String
  subjectId        String?
  subjectName      String?
  title            String
  mode             QuizMode             @default(QUIZ)
  totalQuestions   Int                  @default(0)
  correctCount     Int                  @default(0)
  incorrectCount   Int                  @default(0)
  skippedCount     Int                  @default(0)
  score            Float                @default(0)
  timeLimitSeconds Int?
  timeUsedSeconds  Int                  @default(0)
  completedAt      DateTime             @default(now())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionResults  QuizQuestionResult[]

  @@index([userId])
  @@index([completedAt])
  @@index([subjectId])
}

model QuizQuestionResult {
  id                 String      @id @default(uuid())
  quizAttemptId      String
  questionId         String
  questionText       String
  questionType       String
  questionDifficulty String
  studentAnswer      String
  correctAnswer      String
  isCorrect          Boolean
  feedback           String
  explanation        String
  markedForReview    Boolean     @default(false)
  createdAt          DateTime    @default(now())
  quizAttempt        QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)

  @@index([quizAttemptId])
}

model Document {
  id                 String               @id @default(uuid())
  userId             String
  filename           String
  fileUrl            String
  fileType           String
  size               Int
  status             DocumentUploadStatus @default(PROCESSING)
  subjectId          String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  extractedAt        DateTime?
  extractedText      String?
  extractionError    String?
  summaryError       String?
  summaryGeneratedAt DateTime?
  summaryText        String?
  formulas           Json?
  importantPoints    Json?
  keyTopics          Json?
  subject            Subject?             @relation(fields: [subjectId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiResults          DocumentAIResult[]

  @@index([userId])
  @@index([subjectId])
}

model DocumentAIResult {
  id         String   @id @default(uuid())
  documentId String
  type       String   // "SUMMARY", "FORMULAS", "KEY_TOPICS", "IMPORTANT_POINTS", "STUDY_NOTES", "QUIZ"
  status     String   // "GENERATING", "READY", "FAILED"
  result     Json?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, type])
  @@index([documentId])
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskType {
  ASSIGNMENT
  QUIZ
  EXAM
  PROJECT
  PRESENTATION
  STUDY
  OTHER
}

enum GoalType {
  TARGET_GPA
  ACADEMIC_PERFORMANCE
  STUDY_CONSISTENCY
  SKILL_DEVELOPMENT
  OTHER
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum StudySessionType {
  POMODORO
  CUSTOM
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum StudyPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum QuizMode {
  QUIZ
  MOCK_EXAM
}

enum DocumentUploadStatus {
  UPLOADING
  READY
  PROCESSING
  FAILED
}
